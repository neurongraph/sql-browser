# Copy to .env and edit. Every key is optional; the defaults shown are used
# when the key is absent. Environment variables of the same name win over .env.

# Where the web UI stores uploaded databases and Excel workbooks. Relative
# paths are resolved against the working directory. Created on first upload.
SQL_BROWSER_DATA_DIR=data

# Ollama model used when none is passed with --model or picked in the web UI.
SQL_BROWSER_DEFAULT_MODEL=gemma4:31b-cloud

# Uploads larger than this are rejected.
SQL_BROWSER_MAX_UPLOAD_MB=256
